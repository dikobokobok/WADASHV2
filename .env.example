# Required for signed sessions in production (minimum 32 characters).
# Generate e.g.: openssl rand -base64 32
SESSION_SECRET=

# Optional: concatenated with password before bcrypt (database leak mitigation).
# PASSWORD_PEPPER=

# Optional anti-spam: Cloudflare Turnstile (when set, registration requires the widget).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
